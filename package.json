{
  "name": "zspf_overview",
  "version": "0.0.1",
  "description": "고객 요청현황",
  "private": true,
  "scripts": {
    "start": "fiori run --open 'index.html'",
    "build": "ui5 build -a --clean-dest --include-task=generateManifestBundle generateCachebusterInfo",
    "deploy": "fiori deploy --config ui5-deploy.yaml -y",
    "deploy-test": "fiori deploy --config ui5-deploy.yaml --testMode true -y"
  },
  "devDependencies": {
    "@ui5/cli": "^3.0.0",
    "@sap/ux-ui5-tooling": "^1",
    "@sap-ux/ui5-middleware-fe-mockserver": "^2"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling",
      "@sap-ux/ui5-middleware-fe-mockserver"
    ]
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "sapux": true
}