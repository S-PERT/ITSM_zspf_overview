  <edmx:DataServices>
    <Schema Namespace="zspf_overview.annotations" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <!--
        Charts, the delay table, selection fields, measure labels and the card navigation are defined
        in the backend metadata extensions (ZSP_ITSM_P_OVERVIEWPAGE / ZSP_ITSM_P_OVERVIEWPAGE_REQ).
        Only the operations manager contact card (ContactDetail, a plain interface view without a
        metadata extension) is annotated here.
      -->
      <Annotations Target="cds_zsp_itsm_p_overviewpage_ui.ContactDetailType">
        <Annotation Term="com.sap.vocabularies.UI.v1.LineItem" Qualifier="ContactList">
          <Collection>
            <Record Type="com.sap.vocabularies.UI.v1.DataField">
              <PropertyValue Property="Value" Path="Mngname"/>
            </Record>
            <Record Type="com.sap.vocabularies.UI.v1.DataField">
              <PropertyValue Property="Value" Path="PositText"/>
            </Record>
          </Collection>
        </Annotation>
        <Annotation Term="com.sap.vocabularies.UI.v1.HeaderInfo">
          <Record>
            <PropertyValue Property="TypeName" String="운영담당자"/>
            <PropertyValue Property="TypeNamePlural" String="운영담당자"/>
            <PropertyValue Property="ImageUrl" Path="AttachmentUrl"/>
            <PropertyValue Property="Title">
              <Record Type="com.sap.vocabularies.UI.v1.DataField">
                <PropertyValue Property="Value" Path="Mngname"/>
              </Record>
            </PropertyValue>
            <PropertyValue Property="Description">
              <Record Type="com.sap.vocabularies.UI.v1.DataField">
                <PropertyValue Property="Value" Path="PositText"/>
              </Record>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="com.sap.vocabularies.Communication.v1.Contact">
          <Record>
            <PropertyValue Property="photo" Path="AttachmentUrl"/>
            <PropertyValue Property="fn" Path="Mngname"/>
            <PropertyValue Property="title" Path="PositText"/>
            <PropertyValue Property="org" Path="UnitText"/>
            <PropertyValue Property="email">
              <Collection>
                <Record>
                  <PropertyValue Property="type" EnumMember="com.sap.vocabularies.Communication.v1.ContactInformationType/work"/>
                  <PropertyValue Property="address" Path="Email"/>
                </Record>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="tel">
              <Collection>
                <Record>
                  <PropertyValue Property="type" EnumMember="com.sap.vocabularies.Communication.v1.PhoneType/work"/>
                  <PropertyValue Property="uri" Path="Phone"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
      </Annotations>

      <Annotations Target="cds_zsp_itsm_p_overviewpage_ui.ContactDetailType/Manager">
        <Annotation Term="com.sap.vocabularies.Common.v1.Text" Path="Mngname"/>
        <Annotation Term="com.sap.vocabularies.UI.v1.TextArrangement" EnumMember="com.sap.vocabularies.UI.v1.TextArrangementType/TextLast"/>
